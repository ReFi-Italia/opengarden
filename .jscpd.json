{
  "$schema": "https://raw.githubusercontent.com/kucherenko/jscpd/master/packages/jscpd/schema.json",
  "threshold": 5,
  "minLines": 8,
  "minTokens": 50,
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/payload-types.ts",
    "**/app/(payload)/admin/**"
  ],
  "path": ["apps/webapp/src", "packages/sdk/src"],
  "extensions": ["ts", "tsx"]
}
