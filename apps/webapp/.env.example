# SQLite file path — the db is created on first boot.
DATABASE_URL=file:./webapp.db

# Minimum 32-character random string — rotate per environment.
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# --- Chain / SDK ---------------------------------------------------------
# Chain the OpenGardenClient writes to. One of:
#   celo-mainnet | celo-alfajores | optimism-mainnet | optimism-sepolia
#   | base-mainnet | base-sepolia
# Canonical schema UIDs ship in the SDK for chains that have completed the
# register + name round; the webapp refuses to boot if chainTransactions has
# activity against a different chain id than this one.
PROTOCOL_CHAIN=optimism-sepolia

# Hex-encoded private key (0x-prefixed) of the funded signer that pays gas
# for all SDK chain calls. The address derived from this key becomes the
# `attesterWallet` on every chain.* mirror.
OPENGARDEN_SIGNER_PRIVATE_KEY=0x...

# JSON-RPC endpoint whose chain id matches PROTOCOL_CHAIN. The task handler
# does not cross-check the RPC's chain id — it trusts this value.
OPENGARDEN_RPC_URL=https://sepolia.optimism.io

# --- Jobs queue ----------------------------------------------------------
# Random 16+ character string. Vercel Cron passes this as
# `Authorization: Bearer $CRON_SECRET` when it hits /api/payload-jobs/run.
# The jobs access check in payload.config.ts verifies the header before
# draining the queue.
CRON_SECRET=replace-me-with-a-random-16-plus-char-string

# Set to `true` ONLY for local dev to enable Payload's in-process autoRun
# clock. Leave unset in production / Vercel — the vercel.json cron drives
# the queue there.
# ENABLE_PAYLOAD_AUTORUN=true

# Seed admin
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=
